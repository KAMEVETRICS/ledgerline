module Demo.Setup where

import DA.Date (Month(..), addDays, date)
import DA.Foldable (forA_)
import DA.List (sortOn)
import DA.Time (time)
import Daml.Script

import Cash
import Fund
import Reporting

data Demo = Demo
  with
    bank : Party
    gp : Party
    gp2 : Party
    gp3 : Party
    admin : Party
    lpA : Party
    lpB : Party
    lpC : Party
    lpD : Party
    lpE : Party
    auditor : Party
    ecosystem : Party
    fund1 : ContractId Fund
    statsDesk : ContractId StatisticsDesk

-- | Seeds a running ledger for the dashboard demo with four quarters of fund
-- history. The ledger runs on the real clock; history is carried by business
-- dates (call dates, payment and distribution value dates, NAV dates), which
-- the contracts check are never in the future.
--
-- Three funds, three managers, one administrator:
--   LL-I  Ledgerline Capital   LPs A, B, C
--   RW-II Ridgeway Partners    LPs A, B       (CC-3 left outstanding)
--   NW-I  Northwind Credit     LPs C, D, E
-- Each quarter: calls paid with realistic delays (some late), distributions,
-- an administrator NAV with per-LP statements, and network statistics that
-- clear the privacy threshold (3 funds, 5 LPs). MFN checks and audit access
-- are left for the live demo.
setup : Script ()
setup = do
  _ <- seedHistory
  pure ()

-- | For Daml Script tests: fix the IDE ledger's clock first.
setupDemo : Script Demo
setupDemo = do
  setTime (time (date 2026 Oct 3) 12 0 0)
  seedHistory

seedHistory : Script Demo
seedHistory = script do
  bank <- allocateParty "Bank"
  gp <- allocateParty "GP"
  gp2 <- allocateParty "GP2"
  gp3 <- allocateParty "GP3"
  admin <- allocateParty "Administrator"
  lpA <- allocateParty "LP_A"
  lpB <- allocateParty "LP_B"
  lpC <- allocateParty "LP_C"
  -- Background investors: real participants in NW-I, without demo logins.
  lpD <- allocateParty "LP_D"
  lpE <- allocateParty "LP_E"
  auditor <- allocateParty "Auditor"
  -- Read-only viewer of network-wide statistics; holds no fund records.
  ecosystem <- allocateParty "Ecosystem"

  forA_ [lpA, lpB, lpC, lpD, lpE] \lp ->
    sub bank do createCmd Cash with issuer = bank; owner = lp; amount = 20000000.0
  forA_ [gp, gp2, gp3] \m ->
    sub bank do createCmd Cash with issuer = bank; owner = m; amount = 1000000.0

  fund1 <- newFund gp admin bank "LL-I" "Ledgerline Credit Fund I" 2025
  fund2 <- newFund gp2 admin bank "RW-II" "Ridgeway Real Estate Debt II" 2025
  fund3 <- newFund gp3 admin bank "NW-I" "Northwind Infrastructure Credit I" 2025
  statsDesk <- sub admin do createCmd StatisticsDesk with administrator = admin; viewer = ecosystem

  _ <- commit fund1 gp lpA 5000000.0 200 True
  _ <- commit fund1 gp lpB 3000000.0 150 True
  _ <- commit fund1 gp lpC 2000000.0 200 False
  _ <- commit fund2 gp2 lpA 4000000.0 175 False
  _ <- commit fund2 gp2 lpB 1000000.0 150 False
  _ <- commit fund3 gp3 lpC 3000000.0 175 False
  _ <- commit fund3 gp3 lpD 4000000.0 150 False
  _ <- commit fund3 gp3 lpE 3000000.0 200 False

  -- 2025 Q4
  capitalCall gp fund1 "LL-I" "CC-1" 1000000.0 (date 2025 Oct 10) "Initial loan portfolio" [(lpA, 2), (lpB, 5), (lpC, 16)]
  capitalCall gp2 fund2 "RW-II" "CC-1" 2000000.0 (date 2025 Oct 27) "Bridge loan book" [(lpA, 3), (lpB, 9)]
  capitalCall gp3 fund3 "NW-I" "CC-1" 1500000.0 (date 2025 Nov 12) "Solar portfolio debt" [(lpD, 2), (lpC, 4), (lpE, 20)]
  quarterEnd admin statsDesk "2025-Q4" (date 2025 Oct 1) (date 2025 Dec 31)
    [("LL-I", 1020000.0), ("RW-II", 2060000.0), ("NW-I", 1520000.0)]

  -- 2026 Q1
  capitalCall gp fund1 "LL-I" "CC-2" 1500000.0 (date 2026 Jan 12) "Second lending tranche" [(lpA, 1), (lpB, 3), (lpC, 6)]
  capitalCall gp3 fund3 "NW-I" "CC-2" 2000000.0 (date 2026 Feb 9) "Wind farm refinancing" [(lpD, 3), (lpC, 5), (lpE, 11)]
  distribute gp2 "RW-II" "D-1" (date 2026 Mar 10) [(lpA, 96000.0), (lpB, 24000.0)]
  quarterEnd admin statsDesk "2026-Q1" (date 2026 Jan 1) (date 2026 Mar 31)
    [("LL-I", 2600000.0), ("RW-II", 2120000.0), ("NW-I", 3600000.0)]

  -- 2026 Q2
  capitalCall gp2 fund2 "RW-II" "CC-2" 750000.0 (date 2026 Apr 14) "Construction draw" [(lpA, 2), (lpB, 18)]
  capitalCall gp fund1 "LL-I" "CC-3" 1000000.0 (date 2026 May 11) "Mid-market loans" [(lpB, 2), (lpA, 3), (lpC, 9)]
  distribute gp3 "NW-I" "D-1" (date 2026 Jun 15) [(lpC, 90000.0), (lpD, 120000.0), (lpE, 90000.0)]
  quarterEnd admin statsDesk "2026-Q2" (date 2026 Apr 1) (date 2026 Jun 30)
    [("LL-I", 3700000.0), ("RW-II", 2950000.0), ("NW-I", 3300000.0)]

  -- 2026 Q3
  distribute gp "LL-I" "D-1" (date 2026 Jul 20) [(lpA, 150000.0), (lpB, 90000.0), (lpC, 60000.0)]
  capitalCall gp3 fund3 "NW-I" "CC-3" 1000000.0 (date 2026 Aug 10) "Grid storage loans" [(lpC, 3), (lpD, 4), (lpE, 7)]
  distribute gp2 "RW-II" "D-2" (date 2026 Sep 8) [(lpA, 160000.0), (lpB, 40000.0)]
  quarterEnd admin statsDesk "2026-Q3" (date 2026 Jul 1) (date 2026 Sep 30)
    [("LL-I", 3620000.0), ("RW-II", 2830000.0), ("NW-I", 4450000.0)]

  -- Live: RW-II CC-3 is outstanding when the demo starts.
  rw <- fundCommitments gp2 "RW-II"
  _ <- sub gp2 do
    exerciseCmd fund2 IssueCapitalCall with
      callId = "CC-3"
      totalAmount = 500000.0
      issuedOn = date 2026 Oct 1
      dueDate = date 2026 Oct 31
      purpose = "Final construction draw"
      commitmentCids = rw

  pure Demo with bank; gp; gp2; gp3; admin; lpA; lpB; lpC; lpD; lpE; auditor; ecosystem; fund1; statsDesk

newFund : Party -> Party -> Party -> Text -> Text -> Int -> Script (ContractId Fund)
newFund gp admin bank fundId name vintage = do
  fundCid <- sub gp do
    createCmd Fund with gp; administrator = admin; cashIssuer = bank; fundId; name; vintage
  _ <- sub admin do createCmd AdminDesk with administrator = admin; gp; fundId
  pure fundCid

commit : ContractId Fund -> Party -> Party -> Decimal -> Int -> Bool -> Script (ContractId Commitment)
commit fundCid gp lp amount fee mfn = do
  let terms = LpTerms with managementFeeBps = fee; carryBps = 2000; mostFavouredNation = mfn
  offerCid <- sub gp do exerciseCmd fundCid OfferCommitment with lp; amount; terms
  sub lp do exerciseCmd offerCid AcceptCommitment

fundCommitments : Party -> Text -> Script [ContractId Commitment]
fundCommitments p fundId = map fst . filter (\(_, c) -> c.fundId == fundId) <$> query @Commitment p

commitmentIn : Party -> Text -> Script (ContractId Commitment, Commitment)
commitmentIn lp fundId = do
  [found] <- filter (\(_, c) -> c.fundId == fundId) <$> query @Commitment lp
  pure found

-- | The largest cash holding of `owner` that covers `amount`.
cashFor : Party -> Decimal -> Script (ContractId Cash)
cashFor owner amount = do
  holdings <- filter (\(_, h) -> h.owner == owner && h.amount >= amount) <$> query @Cash owner
  case sortOn (\(_, h) -> negate h.amount) holdings of
    (cid, _) :: _ -> pure cid
    [] -> abort ("No single cash holding of " <> show owner <> " covers " <> show amount)

-- | A call dated `issued`, due 14 days later; each LP's payment has a value
-- date `delay` days after the call (delays past 14 are late payments).
capitalCall : Party -> ContractId Fund -> Text -> Text -> Decimal -> Date -> Text -> [(Party, Int)] -> Script ()
capitalCall gp fundCid fundId callId total issued purpose payments = do
  cids <- fundCommitments gp fundId
  _ <- sub gp do
    exerciseCmd fundCid IssueCapitalCall with
      callId
      totalAmount = total
      issuedOn = issued
      dueDate = addDays issued 14
      purpose
      commitmentCids = cids
  forA_ (sortOn snd payments) \(lp, delay) ->
    payCall lp fundId callId (addDays issued delay)

payCall : Party -> Text -> Text -> Date -> Script ()
payCall lp fundId callId valueDate = do
  [(noticeCid, notice)] <- filter (\(_, n) -> n.fundId == fundId && n.callId == callId) <$> query @CapitalCallNotice lp
  (commitmentCid, _) <- commitmentIn lp fundId
  cashCid <- cashFor lp notice.amount
  _ <- sub lp do exerciseCmd noticeCid PayCall with commitmentCid; cashCid; valueDate
  pure ()

distribute : Party -> Text -> Text -> Date -> [(Party, Decimal)] -> Script ()
distribute gp fundId distributionId on payouts =
  forA_ payouts \(lp, amount) -> do
    [(commitmentCid, _)] <- filter (\(_, c) -> c.fundId == fundId && c.lp == lp) <$> query @Commitment gp
    cashCid <- cashFor gp amount
    sub gp do exerciseCmd commitmentCid Distribute with distributionId; amount; cashCid; valueDate = on

-- | Quarter close: one NAV per fund (with LP statements), then network
-- statistics over every fund, using payments made during the quarter.
quarterEnd : Party -> ContractId StatisticsDesk -> Text -> Date -> Date -> [(Text, Decimal)] -> Script ()
quarterEnd admin statsDesk period qStart qEnd navs = do
  desks <- query @AdminDesk admin
  forA_ navs \(fundId, nav) -> do
    [(deskCid, _)] <- pure (filter (\(_, d) -> d.fundId == fundId) desks)
    cids <- fundCommitments admin fundId
    sub admin do exerciseCmd deskCid PublishNav with asOf = qEnd; nav; commitmentCids = cids
  commitments <- map fst <$> query @Commitment admin
  navCids <- map fst . filter (\(_, n) -> n.asOf == qEnd) <$> query @NavStatement admin
  receipts <- map fst . filter (\(_, r) -> r.valueDate >= qStart && r.valueDate <= qEnd)
    <$> query @ContributionReceipt admin
  _ <- sub admin do
    exerciseCmd statsDesk PublishStatistics with
      period
      asOf = qEnd
      commitmentCids = commitments
      navCids
      receiptCids = receipts
  pure ()

-- | All seed submissions go through here.
sub : Party -> Commands a -> Script a
sub = submit
